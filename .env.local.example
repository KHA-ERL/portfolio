# Environment Variables — Michael Paul Portfolio
# Copy this file to .env.local and fill in your values.
# Do NOT commit .env.local to version control.

# ── Sanity ───────────────────────────────────────────────────────────────────
# Get these from: https://sanity.io/manage → your project → Settings → API

# Your Sanity project ID (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Dataset name (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# API version — use today's date or leave as-is
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token — optional for public data, required for draft previews
# Create one at: Settings → API → Tokens → Add API token (Viewer role)
SANITY_API_READ_TOKEN=

# ── Vercel (set automatically in production) ─────────────────────────────────
# VERCEL_URL is set by Vercel automatically — no need to set manually
